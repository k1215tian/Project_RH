<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_type_list" model="ir.ui.view">
        <field name="name">project.type.list</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <list string="Project Types">
                <field name="code"/>
                <field name="name"/>
                <!-- <field name="sequence_id"/> -->
                <field name="color" widget="color_picker"/>

            </list>
        </field>
    </record>

    <record id="view_project_type_form" model="ir.ui.view">
        <field name="name">project.type.form</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <form string="Project Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Project Type Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Fixed Price, T&amp;M..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="1"/>
                            <field name="color" widget="color_picker"/>
                            <!-- <field name="sequence_id" string="Model" required="1" options="{'no_create': True}"/> -->
                        </group>
                        <group>
                            <field name="description" placeholder="Type notes or terms..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Accounting Accounts" name="accounting_config">
                            <group>
                                <group string="Income &amp; Expense">
                                    <field name="income_account_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="salary_account_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="accrued_expense_id" options="{'no_create': True, 'no_open': True}"/>
                                </group>
                                <group string="Costs &amp; Discounts">
                                    <field name="discount_account_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="overhead_account_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="cost_account_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">project.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>