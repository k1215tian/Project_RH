<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_view_form_simplified_inherit_leader" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.inherit.leader</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- Project Code & Type -->
            <xpath expr="//field[@name='name']" position="after">
                <h4>
                    <div class="d-flex align-items-center gap-3">
                        <label for="code" string="Code:"/>
                        <field name="code" required="1" class="fw-bold text-dark" placeholder="e.g. PRJ-2026-001"/>
                        <label for="project_type_id" string="Type:"/>
                        <field name="project_type_id" required="1" options="{'no_create': True, 'no_open': True}" class="fw-bold text-dark"/>
                    </div>
                </h4>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="after">
                <group>
                    <group name="leader" string="Leader &amp; Responsible">
                        <field name="project_lead_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="account_manager_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>

                    <group name="team" string="Team">
                        <field name="team_id" options="{'no_create': True, 'no_open': False}"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
    <!-- View project.project form -->
    <record id="edit_project_inherit_custom" model="ir.ui.view">
        <field name="name">project.project.form.inherit.custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_documents" icon="fa-folder-open-o">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div name="custom_code">
                    <h4>
                        <span>Code: <field name="code" class="fw-bold text-dark" placeholder="e.g. PRJ-2026-001"/>
                        </span>
                        <br/>
                        <span>Type: <field name="project_type_id" options="{'no_create': True}" class="fw-bold text-dark"/>
                        </span>
                    </h4>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Project Specs &amp; Details" name="custom_project_details">
                    <group>
                        <group string="General Info">
                            <field name="spect_project"/>
                            <field name="project_lead_id" widget="many2one_avatar_user" options="{'no_create': True, 'no_open': True}" />
                            <field name="account_manager_id" widget="many2one_avatar_user" options="{'no_create': True, 'no_open': True}" />
                            <field name="project_link" widget="url" placeholder="e.g. www.google.com"/>
                        </group>
                        <group string="Financials">
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Workflow Teams">
                            <field name="validator_ids" widget="many2many_avatar_user" options="{'no_create': True, 'no_open': True}" />
                            <field name="approval_ids" widget="many2many_avatar_user" options="{'no_create': True, 'no_open': True}" />
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" placeholder="Write project description here..."/>
                </page>
                <page string="Background Project" name="project_documents_tab">
                    <label for="background" string="Background"/>
                    <field name="background" placeholder="Write project background here..."/>
                    <label for="current_issue" string="Current Issue"/>
                    <field name="current_issue" placeholder="Write current issue here..."/>
                    <label for="expected_result" string="Expected Result"/>
                    <field name="expected_result" placeholder="Write expected result here..."/>
                </page>
                <page string="Documents" name="project_documents_tab">
                    <field name="document_ids" context="{'default_project_id': id}">
                        <list string="Project Documents" decoration-info="state == 'draft'" decoration-warning="state == 'uploaded'" decoration-success="state == 'verified'" decoration-danger="state == 'rejected'">
                            <field name="name"/>
                            <field name="type"/>
                            <field name="upload_date"/>
                            <field name="uploaded_by" widget="many2one_avatar_user" options="{'no_create': True}"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'uploaded'" decoration-success="state == 'verified'" decoration-danger="state == 'rejected'"/>
                        </list>
                    </field>
                </page>
                <page string="Stock Moves / COGS" name="stock_moves_cogs">
                    <!-- Menampilkan list barang (stock.move) yang berelasi -->
                    <field name="move_ids" readonly="1" context="{'default_project_id': id}">
                        <list string="Stock Moves">
                            <field name="product_id"/>
                            <field name="picking_type_id" string="Picking Type"/>
                            <field name="product_uom_qty" string="Quantity"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>