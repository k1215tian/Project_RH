<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_documents_list" model="ir.ui.view">
        <field name="name">project.documents.list</field>
        <field name="model">project.documents</field>
        <field name="arch" type="xml">
            <list string="Project Documents" decoration-info="state == 'draft'" decoration-warning="state == 'uploaded'" decoration-success="state == 'verified'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="type"/>
                <field name="upload_date"/>
                <field name="uploaded_by" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'uploaded'" decoration-success="state == 'verified'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_project_documents_form" model="ir.ui.view">
        <field name="name">project.documents.form</field>
        <field name="model">project.documents</field>
        <field name="arch" type="xml">
            <form string="Project Document">
                <header>
                    <button name="action_upload" string="Upload File" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_verify" string="Verify" type="object" class="btn-success" invisible="state != 'uploaded'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'uploaded'"/>
                    <button name="action_set_to_draft" string="Reset to Draft" type="object" invisible="state in ['draft', 'verified']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,uploaded,verified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="project_id" options="{'no_create': True}" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Document Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. BAST Project Phase 1" required="1"/>
                        </h1>
                        <span>Type: <field name="type" required="1" placeholder="Type Document"/>
                        </span>
                    </div>

                    <group>
                        <group string="File Info">
                            <field name="filename" invisible="1"/>
                            <field name="filebinary" filename="filename" widget="binary" string="Upload File Attachment"/>
                        </group>
                        <group string="Audit Trail">
                            <field name="upload_date" readonly="1"/>
                            <field name="uploaded_by" widget="many2one_avatar_user"/>
                            <field name="verified_by" widget="many2one_avatar_user" invisible="state != 'verified'"/>
                            <field name="verified_date" invisible="state != 'verified'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Checklists &amp; Scope" name="checklists" invisible="1">
                            <group>
                                <group string="Standard Checklist">
                                    <field name="check_contract" widget="boolean_toggle"/>
                                    <field name="check_po" widget="boolean_toggle"/>
                                    <field name="check_bast" widget="boolean_toggle"/>
                                    <field name="check_lap" widget="boolean_toggle"/>
                                </group>
                                <group string="Additional Checklist">
                                    <field name="check_sheet" widget="boolean_toggle"/>
                                    <field name="check_absensi" widget="boolean_toggle"/>
                                    <field name="check_sertifikat" widget="boolean_toggle"/>
                                    <field name="check_others" widget="boolean_toggle"/>
                                    <field name="titleothers" placeholder="Specify other document name..." invisible="not check_others" required="check_others"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Add some internal descriptions or rejection reasons here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_documents" model="ir.actions.act_window">
        <field name="name">Project Documents</field>
        <field name="res_model">project.documents</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>