<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View crm.team form -->
    <record id="crm_team_view_form_inherit_project" model="ir.ui.view">
        <field name="name">crm.team.form.inherit.project</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="team_type" widget="radio" options="{'horizontal': true}"/>
            </xpath>
            <xpath expr="//page[@name='members_users']" position="attributes">
                <attribute name="invisible">team_type == 'project'</attribute>
                <attribute name="string">Sales Members</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Project Members" name="project_members" invisible="team_type != 'project'">
                    <field name="team_member_ids" mode="kanban" class="w-100">
                        <kanban>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_card d-flex align-items-center p-2">
                                        <field name="avatar_128" widget="image" class="rounded me-2" style="width:60px;height:60px;border-radius:50%;"/>
                                        <main class="ms-3">
                                            <strong><field name="name" class="fw-bold fs-5"/></strong>
                                            <div class="d-flex align-items-baseline text-break">
                                                <i class="fa fa-envelope me-1" role="img" aria-label="Email" title="Email"/><field name="email"/>
                                            </div>
                                        </main>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_project_team_config" model="ir.actions.act_window">
        <field name="name">Project Teams</field>
        <field name="res_model">crm.team</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('team_type', '=', 'project')]</field>
        <field name="context">{'default_team_type': 'project'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Project Team!
            </p>
        </field>
    </record>

</odoo>