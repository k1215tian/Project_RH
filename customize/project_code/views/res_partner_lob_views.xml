<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_lob_list" model="ir.ui.view">
        <field name="name">res.partner.lob.list</field>
        <field name="model">res.partner.lob</field>
        <field name="arch" type="xml">
            <list string="Line of Business" editable="bottom" delete="false" duplicate="false">
                <field name="code" required="1" readonly="islock"/>
                <field name="name" required="1" readonly="islock"/>
                <field name="islock" column_invisible="1"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_res_partner_lob" model="ir.actions.act_window">
        <field name="name">Line of Business (LOB)</field>
        <field name="res_model">res.partner.lob</field>
        <field name="view_mode">list</field>
    </record>
</odoo>