<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_master_periods" model="ir.cron">
            <field name="name">Generate Next Year Master Periods</field>
            <field name="model_id" ref="model_om_master_period_scheduler"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_periods()</field>
            <field name="user_id" ref="base.user_root"/>
            <!-- Set eksekusi 1 tahun sekali -->
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(month=12, day=31, hour=16, minute=59, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron Auto State & Deactivate Weekly -->
        <record id="ir_cron_auto_update_weekly_state" model="ir.cron">
            <field name="name">Weekly Period: Auto Change State &amp; Deactivate</field>
            <field name="model_id" ref="model_om_master_weekly"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_period_states()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=5, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>