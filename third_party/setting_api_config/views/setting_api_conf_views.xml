<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================= -->
        <!-- LIST VIEW                                         -->
        <!-- ================================================= -->

        <record id="view_setting_api_conf_list" model="ir.ui.view">
            <field name="name">setting.api.conf.list</field>
            <field name="model">setting.api.conf</field>
            <field name="arch" type="xml">
                <list string="API Configurations" decoration-success="active" decoration-muted="not active">

                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="api_type" widget="badge"/>
                    <field name="auth_type" widget="badge"/>
                    <field name="server_url" optional="hide"/>

                    <field name="usable_requests" string="Remaining"/>
                    <field name="limit_request" string="Request Limit"/>

                    <field name="usage_percentage" widget="progressbar" string="Usage"/>

                    <field name="total_requests"/>
                    <field name="successful_requests" optional="hide"/>
                    <field name="failed_requests" optional="hide"/>

                    <field name="reset_period"/>
                    <field name="next_reset_date" optional="hide"/>

                    <field name="active" widget="boolean_toggle"/>

                </list>
            </field>
        </record>


        <!-- ================================================= -->
        <!-- KANBAN MONITORING DASHBOARD                       -->
        <!-- ================================================= -->

        <record id="view_setting_api_conf_kanban" model="ir.ui.view">
            <field name="name">setting.api.conf.kanban</field>
            <field name="model">setting.api.conf</field>
            <field name="arch" type="xml">

                <kanban default_group_by="api_type" class="o_kanban_dashboard" create="true">

                    <field name="name"/>
                    <field name="api_type"/>
                    <field name="auth_type"/>
                    <field name="server_url"/>
                    <field name="active"/>
                    <field name="company_id"/>

                    <field name="usable_requests"/>
                    <field name="limit_request"/>
                    <field name="usage_percentage"/>
                    <field name="remaining_percentage"/>

                    <field name="total_requests"/>
                    <field name="successful_requests"/>
                    <field name="failed_requests"/>

                    <field name="total_input_tokens"/>
                    <field name="total_output_tokens"/>
                    <field name="total_thinking_tokens"/>
                    <field name="total_tokens"/>

                    <field name="reset_period"/>
                    <field name="last_reset_date"/>
                    <field name="next_reset_date"/>

                    <templates>

                        <t t-name="card">

                            <div class="oe_kanban_global_click border rounded-3 shadow-sm overflow-hidden">

                                <!-- HEADER -->

                                <div class="p-3 border-bottom">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div class="flex-grow-1">

                                            <strong class="fs-5 text-truncate">
                                                <field name="name"/>
                                            </strong>

                                            <div class="text-muted small mt-1 text-truncate">
                                                <field name="server_url"/>
                                            </div>

                                        </div>

                                        <div class="ms-2">
                                            <field name="active" widget="boolean_toggle"/>
                                        </div>

                                    </div>

                                    <div class="d-flex flex-wrap gap-2 mt-3">

                                        <span class="badge text-bg-primary">
                                            <field name="api_type"/>
                                        </span>

                                        <span class="badge text-bg-secondary">
                                            <field name="auth_type"/>
                                        </span>

                                    </div>

                                </div>


                                <!-- QUOTA MONITORING -->

                                <div class="p-3">

                                    <div class="d-flex justify-content-between align-items-center mb-2">

                                        <strong class="text-uppercase small text-muted">
                                            Request Quota
                                        </strong>

                                        <t t-if="not record.active.raw_value">

                                            <span class="badge text-bg-secondary">
                                                Inactive
                                            </span>

                                        </t>

                                        <t t-elif="record.usable_requests.raw_value == 0">

                                            <span class="badge text-bg-danger">
                                                Exhausted
                                            </span>

                                        </t>

                                        <t t-elif="record.remaining_percentage.raw_value &lt;= 20">

                                            <span class="badge text-bg-warning">
                                                Low Quota
                                            </span>

                                        </t>

                                        <t t-else="">

                                            <span class="badge text-bg-success">
                                                Healthy
                                            </span>

                                        </t>

                                    </div>

                                    <div class="d-flex justify-content-between align-items-end">

                                        <div>

                                            <div class="text-muted small">
                                                Remaining Requests
                                            </div>

                                            <strong class="display-6">
                                                <field name="usable_requests"/>
                                            </strong>

                                        </div>

                                        <div class="text-end">

                                            <div class="text-muted small">
                                                Request Limit
                                            </div>

                                            <strong class="fs-4">
                                                <field name="limit_request"/>
                                            </strong>

                                        </div>

                                    </div>

                                    <div class="mt-3">

                                        <div class="d-flex justify-content-between mb-1">

                                            <span class="small text-muted">
                                                Usage
                                            </span>

                                            <strong class="small">
                                                <field name="usage_percentage"/>
%
                                            </strong>

                                        </div>

                                        <field name="usage_percentage" widget="progressbar"/>

                                    </div>

                                </div>


                                <!-- REQUEST STATISTICS -->

                                <div class="border-top border-bottom p-3">

                                    <strong class="text-uppercase small text-muted">
                                        Request Statistics
                                    </strong>

                                    <div class="row text-center mt-3">

                                        <div class="col-4">

                                            <div class="fs-3 fw-bold">
                                                <field name="total_requests"/>
                                            </div>

                                            <div class="small text-muted">
                                                Total
                                            </div>

                                        </div>

                                        <div class="col-4">

                                            <div class="fs-3 fw-bold text-success">
                                                <field name="successful_requests"/>
                                            </div>

                                            <div class="small text-muted">
                                                Success
                                            </div>

                                        </div>

                                        <div class="col-4">

                                            <div class="fs-3 fw-bold text-danger">
                                                <field name="failed_requests"/>
                                            </div>

                                            <div class="small text-muted">
                                                Failed
                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- AI TOKEN MONITORING -->

                                <t t-if="record.api_type.raw_value == 'ai'">

                                    <div class="p-3 border-bottom">

                                        <strong class="text-uppercase small text-muted">
                                            AI Token Usage
                                        </strong>

                                        <div class="mt-2">

                                            <div class="d-flex justify-content-between">

                                                <span class="small text-muted">
                                                    Total Tokens
                                                </span>

                                                <strong>
                                                    <field name="total_tokens"/>
                                                </strong>

                                            </div>

                                            <div class="d-flex justify-content-between mt-2">

                                                <span class="small text-muted">
                                                    Input Tokens
                                                </span>

                                                <span>
                                                    <field name="total_input_tokens"/>
                                                </span>

                                            </div>

                                            <div class="d-flex justify-content-between mt-1">

                                                <span class="small text-muted">
                                                    Output Tokens
                                                </span>

                                                <span>
                                                    <field name="total_output_tokens"/>
                                                </span>

                                            </div>

                                            <div class="d-flex justify-content-between mt-1">

                                                <span class="small text-muted">
                                                    Thinking Tokens
                                                </span>

                                                <span>
                                                    <field name="total_thinking_tokens"/>
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </t>


                                <!-- RESET INFORMATION -->

                                <div class="p-3">

                                    <strong class="text-uppercase small text-muted">
                                        Quota Reset Information
                                    </strong>

                                    <div class="d-flex justify-content-between mt-2">

                                        <span class="text-muted small">
                                            Reset Period
                                        </span>

                                        <strong class="small">
                                            <field name="reset_period"/>
                                        </strong>

                                    </div>

                                    <div class="d-flex justify-content-between mt-2">

                                        <span class="text-muted small">
                                            Last Reset
                                        </span>

                                        <span class="small">
                                            <field name="last_reset_date"/>
                                        </span>

                                    </div>

                                    <div class="d-flex justify-content-between mt-2">

                                        <span class="text-muted small">
                                            Next Reset
                                        </span>

                                        <span class="small">
                                            <field name="next_reset_date"/>
                                        </span>

                                    </div>

                                </div>


                                <!-- FOOTER -->

                                <div class="border-top p-3 bg-light">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <span class="small text-muted">

                                            <i class="fa fa-building me-1"/>

                                            <field name="company_id"/>

                                        </span>

                                        <span class="small text-muted">

                                            <i class="fa fa-shield me-1"/>

                                            API Integration

                                        </span>

                                    </div>

                                </div>

                            </div>

                        </t>

                    </templates>

                </kanban>

            </field>
        </record>


        <!-- ================================================= -->
        <!-- FORM VIEW                                         -->
        <!-- ================================================= -->

        <record id="view_setting_api_conf_form" model="ir.ui.view">

            <field name="name">setting.api.conf.form</field>
            <field name="model">setting.api.conf</field>

            <field name="arch" type="xml">

                <form string="API Configuration">

                    <header>

                        <button name="action_reset_quota" type="object" string="Reset Quota" class="btn-primary" icon="fa-refresh" confirm="Are you sure you want to reset the API quota?"/>

                        <field name="active" widget="boolean_toggle"/>

                    </header>

                    <sheet>

                        <div class="oe_title">

                            <label for="name"/>

                            <h1>
                                <field name="name" placeholder="API Configuration Name"/>
                            </h1>

                        </div>

                        <group>

                            <group string="General Information">

                                <field name="company_id" groups="base.group_multi_company"/>

                                <field name="api_type"/>

                                <field name="registration_number"/>

                                <field name="account_id"/>

                            </group>

                            <group string="Connection Settings">

                                <field name="server_url"/>

                                <field name="timeout"/>

                                <field name="verify_ssl"/>

                                <field name="date_format"/>

                            </group>

                        </group>

                        <notebook>

                            <!-- AUTHENTICATION -->

                            <page string="Authentication" name="authentication">

                                <group>

                                    <group string="Authentication Method">

                                        <field name="auth_type"/>

                                        <field name="api_key" password="True" groups="base.group_system" invisible="auth_type not in ('api_key', 'bearer')"/>

                                    </group>

                                    <group string="Basic Authentication" invisible="auth_type != 'basic'">

                                        <field name="auth_username" groups="base.group_system"/>

                                        <field name="auth_password" password="True" groups="base.group_system"/>

                                    </group>

                                </group>

                                <group string="Custom Header" invisible="auth_type != 'custom'">

                                    <field name="auth_header_name"/>

                                    <field name="auth_header_value" password="True" groups="base.group_system"/>

                                </group>

                                <group string="API Credential">

                                    <field name="credential_id"/>

                                </group>

                            </page>


                            <!-- SECURITY -->

                            <page string="Security" name="security">

                                <group>

                                    <group string="Network Security">

                                        <field name="verify_ssl"/>

                                        <field name="allow_private_network" groups="base.group_system"/>

                                    </group>

                                    <group string="Logging Security">

                                        <field name="log_response_body" groups="base.group_system"/>

                                    </group>

                                </group>

                            </page>


                            <!-- CALLBACK -->

                            <page string="Callback" name="callback">

                                <group>

                                    <group string="Callback URL">

                                        <field name="callback_token" readonly="True"/>

                                        <field name="callback_url" widget="url" readonly="True"/>

                                    </group>

                                    <group string="Callback Security">

                                        <field name="callback_secret" password="True" groups="base.group_system"/>

                                    </group>

                                </group>

                                <group string="Callback Logs">

                                    <field name="callback_ids" readonly="True"/>

                                </group>

                            </page>


                            <!-- QUOTA MANAGEMENT -->

                            <page string="Quota Management" name="quota_management">

                                <group>

                                    <group string="Request Limits">

                                        <field name="limit_request"/>

                                        <field name="usable_requests"/>

                                        <field name="reset_period"/>

                                    </group>

                                    <group string="Reset Information">

                                        <field name="last_reset_date" readonly="True"/>

                                        <field name="next_reset_date" readonly="True"/>

                                    </group>

                                </group>

                                <group string="Quota Usage">

                                    <field name="usage_percentage" widget="progressbar"/>

                                    <field name="remaining_percentage" widget="progressbar"/>

                                </group>

                            </page>


                            <!-- USAGE STATISTICS -->

                            <page string="Usage Statistics" name="usage_statistics">

                                <group>

                                    <group string="Request Statistics">

                                        <field name="total_requests"/>

                                        <field name="successful_requests"/>

                                        <field name="failed_requests"/>

                                    </group>

                                    <group string="Token Statistics">

                                        <field name="total_input_tokens"/>

                                        <field name="total_output_tokens"/>

                                        <field name="total_thinking_tokens"/>

                                        <field name="total_tokens"/>

                                    </group>

                                </group>

                            </page>


                            <!-- API USAGE LOGS -->

                            <page string="API Usage Logs" name="api_usage_logs">

                                <field name="log_ids" readonly="True">

                                    <list create="false" edit="false" delete="false">

                                        <field name="create_date"/>

                                        <field name="direction"/>

                                        <field name="request_id"/>

                                        <field name="endpoint"/>

                                        <field name="method"/>

                                        <field name="state" widget="badge"/>

                                        <field name="status_code"/>

                                        <field name="duration_ms"/>

                                        <field name="input_tokens"/>

                                        <field name="output_tokens"/>

                                        <field name="thinking_tokens"/>

                                        <field name="total_tokens"/>

                                        <field name="callback_state"/>

                                    </list>

                                </field>

                            </page>


                            <!-- RESET HISTORY -->

                            <page string="Reset History" name="reset_history">

                                <field name="reset_history_ids" readonly="True">

                                    <list create="true" edit="false" delete="false">

                                        <field name="reset_date"/>

                                        <field name="reset_type"/>

                                        <field name="old_quota"/>

                                        <field name="new_quota"/>

                                        <field name="user_id"/>

                                    </list>

                                </field>

                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>

                </form>

            </field>

        </record>


        <!-- ================================================= -->
        <!-- SEARCH VIEW                                       -->
        <!-- ================================================= -->

        <record id="view_setting_api_conf_search" model="ir.ui.view">

            <field name="name">setting.api.conf.search</field>
            <field name="model">setting.api.conf</field>

            <field name="arch" type="xml">

                <search string="Search API Configurations">

                    <field name="name"/>
                    <field name="server_url"/>
                    <field name="registration_number"/>
                    <field name="account_id"/>
                    <field name="api_type"/>
                    <field name="auth_type"/>

                    <separator/>

                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>

                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>

                    <separator/>

                    <filter name="ai" string="AI" domain="[('api_type', '=', 'ai')]"/>

                    <filter name="payment" string="Payment" domain="[('api_type', '=', 'payment')]"/>

                    <filter name="shipping" string="Shipping" domain="[('api_type', '=', 'shipping')]"/>

                    <filter name="communication" string="Communication" domain="[('api_type', '=', 'communication')]"/>

                    <filter name="storage" string="Storage" domain="[('api_type', '=', 'storage')]"/>

                    <filter name="social" string="Social Media" domain="[('api_type', '=', 'social')]"/>

                    <separator/>

                    <filter name="quota_exhausted" string="Quota Exhausted" domain="[('usable_requests', '=', 0)]"/>

                    <filter name="quota_available" string="Quota Available" domain="[('usable_requests', '&gt;', 0)]"/>

                    <separator/>

                    <filter name="reset_daily" string="Daily Reset" domain="[('reset_period', '=', 'daily')]"/>

                    <filter name="reset_monthly" string="Monthly Reset" domain="[('reset_period', '=', 'monthly')]"/>

                    <group expand="0" string="Group By">

                        <filter name="group_api_type" string="API Type" context="{'group_by': 'api_type'}"/>

                        <filter name="group_auth_type" string="Authentication" context="{'group_by': 'auth_type'}"/>

                        <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>

                        <filter name="group_reset_period" string="Reset Period" context="{'group_by': 'reset_period'}"/>

                    </group>

                </search>

            </field>

        </record>


        <!-- ================================================= -->
        <!-- WINDOW ACTION                                     -->
        <!-- ================================================= -->

        <record id="action_setting_api_conf" model="ir.actions.act_window">

            <field name="name">API Configurations</field>

            <field name="res_model">setting.api.conf</field>

            <field name="view_mode">kanban,list,form</field>

            <field name="search_view_id" ref="view_setting_api_conf_search"/>

            <field name="context">
                {'search_default_active': 1}
            </field>

            <field name="help" type="html">

                <p class="o_view_nocontent_smiling_face">
                    Create your first API Configuration!
                </p>

                <p>
                    Manage external API integrations, authentication,
                    credentials, callbacks, request quotas,
                    security and API usage statistics.
                </p>

            </field>

        </record>
    </data>
</odoo>
