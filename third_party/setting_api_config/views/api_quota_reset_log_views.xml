<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View api.quota.reset.log View List -->
    <record id="view_api_quota_reset_log_list" model="ir.ui.view">
        <field name="name">view.api.quota.reset.log.list</field>
        <field name="model">api.quota.reset.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View api.quota.reset.log form -->
    <record id="view_api_quota_reset_log_form" model="ir.ui.view">
        <field name="name">view.api.quota.reset.log.form</field>
        <field name="model">api.quota.reset.log</field>
        <field name="arch" type="xml">
            <form string="Api Quota Reset Log">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View api.quota.reset.log search -->
    <record id="view_api_quota_reset_log_search" model="ir.ui.view">
        <field name="name">view.api.quota.reset.log.search</field>
        <field name="model">api.quota.reset.log</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action api.quota.reset.log -->
    <record id="action_api_quota_reset_log" model="ir.actions.act_window">
        <field name="name">Api Quota Reset Log</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">api.quota.reset.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Api Quota Reset Log.
            </p>
        </field>
    </record>

</odoo>
