<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Log List View -->
    <record id="view_api_usage_log_tree" model="ir.ui.view">
        <field name="name">api.usage.log.tree</field>
        <field name="model">api.usage.log</field>
        <field name="arch" type="xml">
            <list string="API Usage Logs" create="0" edit="0" delete="0">

                <field name="name"/>
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="company_id"/>
                <field name="endpoint"/>
                <field name="method"/>
                <field name="status_code"/>

                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state in ('error', 'failed')"/>

            </list>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_api_usage_log_form" model="ir.ui.view">
        <field name="name">api.usage.log.form</field>
        <field name="model">api.usage.log</field>
        <field name="arch" type="xml">
            <form string="API Usage Log" create="0" edit="0" delete="0">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Request Information">
                            <field name="config_id"/>
                            <field name="company_id"/>
                            <field name="endpoint"/>
                            <field name="method"/>
                        </group>

                        <group string="Response Information">
                            <field name="status_code"/>
                            <field name="state" widget="badge"/>
                            <field name="create_date"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Response">
                            <field name="response_body" nolabel="1"/>
                        </page>

                        <page string="Error Message">
                            <field name="error_message" nolabel="1"/>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Log Search View -->
    <record id="view_api_usage_log_search" model="ir.ui.view">
        <field name="name">api.usage.log.search</field>
        <field name="model">api.usage.log</field>
        <field name="arch" type="xml">
            <search string="Search API Logs">

                <field name="name"/>
                <field name="config_id"/>
                <field name="endpoint"/>
                <field name="status_code"/>

                <filter name="success" string="Success" domain="[('state', '=', 'success')]"/>

                <filter name="error" string="HTTP Error" domain="[('state', '=', 'error')]"/>

                <filter name="failed" string="Connection Failed" domain="[('state', '=', 'failed')]"/>

                <separator/>

                <filter name="today" string="Today" date="create_date"/>

                <group expand="0" string="Group By">
                    <filter name="group_config" string="Configuration" context="{'group_by': 'config_id'}"/>

                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>

                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- Log Action -->
    <record id="action_api_usage_log" model="ir.actions.act_window">
        <field name="name">API Usage Logs</field>
        <field name="res_model">api.usage.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_api_usage_log_search"/>
    </record>

</odoo>
