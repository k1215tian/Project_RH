<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View api.webhook.handler View List -->
    <record id="view_api_webhook_handler_list" model="ir.ui.view">
        <field name="name">view.api.webhook.handler.list</field>
        <field name="model">api.webhook.handler</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View api.webhook.handler form -->
    <record id="view_api_webhook_handler_form" model="ir.ui.view">
        <field name="name">view.api.webhook.handler.form</field>
        <field name="model">api.webhook.handler</field>
        <field name="arch" type="xml">
            <form string="Api Webhook Handler">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View api.webhook.handler search -->
    <record id="view_api_webhook_handler_search" model="ir.ui.view">
        <field name="name">view.api.webhook.handler.search</field>
        <field name="model">api.webhook.handler</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action api.webhook.handler -->
    <record id="action_api_webhook_handler" model="ir.actions.act_window">
        <field name="name">Api Webhook Handler</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">api.webhook.handler</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Api Webhook Handler.
            </p>
        </field>
    </record>

</odoo>
