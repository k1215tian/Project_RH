<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_internal_auto_replenishment_0" model="ir.cron">
        <field name="name">Auto Replenishment</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"
        />
        <field name="model_id" ref="model_stock_picking_type" />
        <field name="state">code</field>
        <field name="code">model.action_internal_auto_replenishment()</field>
    </record>
</odoo>
