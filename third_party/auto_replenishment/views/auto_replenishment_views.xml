<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_auto_replenishment_period_tag_list" model="ir.ui.view">
        <field name="name">auto.replenishment.period.tag.list</field>
        <field name="model">auto.replenishment.period.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_stop"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_auto_replenishment_period_tags" model="ir.actions.act_window">
        <field name="name">Auto Replenishment Periods</field>
        <field name="res_model">auto.replenishment.period.tag</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_auto_replenishment_period_tag_list"/>
    </record>

    <menuitem id="menu_auto_replenishment_period_tags" name="Auto Replenishment Periods" parent="stock.menu_stock_config_settings"
              sequence="60" action="action_auto_replenishment_period_tags" groups="stock.group_stock_manager"/>
</odoo>